{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ],
    "allow": [
      "Bash(./scripts/*)",
      "Bash(node build.mjs*)",
      "Bash(npx hyperframes *)",
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(./scripts/ship.sh *)",
      "Bash(cd app && npm run *)",
      "Bash(cd app && npm test*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(node hyperframes/*/build.mjs*)",
      "Bash(cd hyperframes && npx hyperframes *)",
      "Bash(git show*)",
      "Bash(git restore --staged*)",
      "Bash(git stash list*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ffprobe *)"
    ],
    "defaultMode": "acceptEdits"
  }
}
