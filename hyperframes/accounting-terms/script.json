  "lines": [
    {
      "text": "Say my shop makes $10,000.",
      "pair": "intro",
      "react": "smile",
      "sfx": [
        "pop"
      ]
    },
    {
      "text": "Why do I only keep $3,000?",
      "pair": "intro",
      "react": "confused",
      "pause": 0.45,
      "actions": [
        {
          "type": "terms",
          "items": [
            "Gross Profit",
            "Net Profit"
          ],
          "word": "keep"
        }
      ]
    },
    {
      "text": "This is gross profit.",
      "pair": "p1",
      "show": "left",
      "react": "point-up-left",
      "sfx": [
        "pop"
      ]
    },
    {
      "text": "And this is net profit.",
      "pair": "p1",
      "show": "right",
      "react": "point-up-right",
      "sfx": [
        "pop"
      ]
    },
    {
      "text": "What's the difference?",
      "pair": "p1",
      "react": "look-up",
      "question": true,
      "sfx": [
        "question"
      ],
      "pause": 0.5
    },
    {
      "text": "Gross profit is what's left",
      "pair": "p1",
      "focus": "left",
      "react": "point-up-left",
      "sfx": [
        "pop"
      ],
      "actions": [
        {
          "type": "pulse",
          "el": "#gp-sales",
          "word": "left"
        }
      ]
    },
    {
      "text": "after subtracting the cost",
      "pair": "p1",
      "focus": "left",
      "react": "point-up-left",
      "actions": [
        {
          "type": "pop",
          "el": "#gp-cogs",
          "word": "cost",
          "sfx": "minus"
        }
      ]
    },
    {
      "text": "of making or buying what you sell.",
      "pair": "p1",
      "focus": "left",
      "react": "point-up-left",
      "actions": [
        {
          "type": "swap",
          "from": "#gp-old",
          "to": "#gp-new",
          "word": "sell.",
          "delay": 0.2,
          "sfx": "coin"
        }
      ]
    },
    {
      "text": "Net profit is what's left",
      "pair": "p1",
      "focus": "right",
      "react": "point-up-right",
      "sfx": [
        "pop"
      ],
      "actions": [
        {
          "type": "pop",
          "el": "#np-gross",
          "word": "left",
          "sfx": "add"
        }
      ]
    },
    {
      "text": "after ALL business expenses.",
      "pair": "p1",
      "focus": "right",
      "react": "point-up-right",
      "pause": 0.55,
      "actions": [
        {
          "type": "pop",
          "el": "#np-exp",
          "word": "ALL",
          "sfx": "minus"
        },
        {
          "type": "swap",
          "from": "#np-old",
          "to": "#np-new",
          "word": "expenses.",
          "delay": 0.3,
          "sfx": "reward"
        }
      ]
    },
    {
      "text": "Now, accounts payable versus accounts receivable!",
      "pair": "p2",
      "react": "look-up-2",
      "sfx": [
        "pop"
      ]
    },
    {
      "text": "Accounts payable is money your business owes.",
      "pair": "p2",
      "focus": "left",
      "react": "point-up-left",
      "sfx": [
        "pop"
      ],
      "actions": [
        {
          "type": "pop",
          "el": "#ap-owe",
          "word": "owes.",
          "sfx": "owe"
        }
      ]
    },
    {
      "text": "Accounts receivable is money customers owe your business.",
      "pair": "p2",
      "focus": "right",
      "react": "point-up-right",
      "sfx": [
        "pop"
      ],
      "pause": 0.5,
      "actions": [
        {
          "type": "pop",
          "el": "#ar-owed",
          "word": "owe",
          "sfx": "coin"
        }
      ]
    },
    {
      "text": "Remember: Payable means you pay.",
      "pair": "recap",
      "react": "chill",
      "recap": {
        "term": "Payable",
        "means": "you pay"
      },
      "sfx": [
        "check"
      ]
    },
    {
      "text": "Receivable means you receive!",
      "pair": "recap",
      "react": "thumbs-up",
      "recap": {
        "term": "Receivable",
        "means": "you receive"
      },
      "sfx": [
        "check"
      ],
      "pause": 0.4
    },
    {
      "text": "Learned something? Like this video and follow for more!",
      "pair": "recap",
      "react": "point-at-you-2",
      "cta": true,
      "ctaType": "like",
      "sfx": [
        "cta"
      ]
    }
  ],
