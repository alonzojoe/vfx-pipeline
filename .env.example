# ElevenLabs — get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Default voice. Find yours with:  ./scripts/voice.sh voices
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# eleven_multilingual_v2 = natural, stable (default)
# eleven_v3              = most expressive, supports [laughs] [whispers] style tags
# eleven_flash_v2_5      = fastest/cheapest
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Voice settings (0–1, speed 0.7–1.2)
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=1
